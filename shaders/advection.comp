#version 450

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(constant_id = 0) const uint NX = 128u;
layout(constant_id = 1) const uint NY = 128u;
const float DT = 0.016f;

layout(std430, binding = 0) buffer USrc { float data[]; } uSrc;
layout(std430, binding = 1) buffer UDst { float data[]; } vSrc;
layout(std430, binding = 2) buffer VSrc { float data[]; } uDst;
layout(std430, binding = 3) buffer VDst { float data[]; } vDst;

layout(std430, binding = 5) buffer LeftB   { uint data[]; } left;
layout(std430, binding = 6) buffer RightB  { uint data[]; } right;
layout(std430, binding = 7) buffer BottomB { uint data[]; } bottom;
layout(std430, binding = 8) buffer TopB    { uint data[]; } top;

// ---------- 边界值 ----------
float border_velocity(float vi, bool is_u, int edge, uint local) {
    uint bi = local * 3u;
    uint type;
    float bc_u, bc_v;

    if (edge == 0) {
        type = left.data[bi];
        bc_u = uintBitsToFloat(left.data[bi+1u]);
        bc_v = uintBitsToFloat(left.data[bi+2u]);
    } else if (edge == 1) {
        type = right.data[bi];
        bc_u = uintBitsToFloat(right.data[bi+1u]);
        bc_v = uintBitsToFloat(right.data[bi+2u]);
    } else if (edge == 2) {
        type = bottom.data[bi];
        bc_u = uintBitsToFloat(bottom.data[bi+1u]);
        bc_v = uintBitsToFloat(bottom.data[bi+2u]);
    } else {
        type = top.data[bi];
        bc_u = uintBitsToFloat(top.data[bi+1u]);
        bc_v = uintBitsToFloat(top.data[bi+2u]);
    }
    switch (type) {
        case 0: // NoSlipWall: 壁面静止, 虚拟速度=0
            return 0.0f;
        case 1: // SlipWall: 法向=0, 切向=边缘值
            return ((edge <= 1) == is_u) ? 0.0f : vi;
        case 2: // Velocity: 虚拟速度=预设值
            return is_u ? bc_u : bc_v;
        case 3: { // Pressure: backflow prevention
            bool is_normal = ((edge <= 1) == is_u);
            if (is_normal) {
                bool entering;
                if (edge == 0) entering = (vi > 0.0);
                else if (edge == 1) entering = (vi < 0.0);
                else if (edge == 2) entering = (vi > 0.0);
                else entering = (vi < 0.0);
                if (entering) return 0.0;
            }
            return vi;
        }
    }
    return 0.0f;
}

// ---------- 双线性插值（边界感知） ----------
float src_at(uint idx, bool is_u) {
    return is_u ? uSrc.data[idx] : vSrc.data[idx];
}

float sampleBilinear(float x, float y, bool is_u) {
    // 检测越界，取最近内部点值 + bc_value 计算 ghost
    if (x < 0.0 || x > float(NX) - 1.0 || y < 0.0 || y > float(NY) - 1.0) {
        float xi = clamp(x, 0.0, float(NX) - 1.0);
        float yi = clamp(y, 0.0, float(NY) - 1.0);
        float vi = src_at(uint(xi) + uint(yi) * NX, is_u);
        int edge; uint local;
        if (x < 0.0) {
            edge = 0;
            local = uint(yi);
        } else if (x > float(NX) - 1.0) {
            edge = 1;
            local = uint(yi);
        } else if (y < 0.0) {
            edge = 2;
            local = uint(xi);
        } else {
            edge = 3;
            local = uint(xi);
        }
        return border_velocity(vi, is_u, edge, local);
    }
    // 内部：标准双线性
    uint ix0 = uint(floor(x)), ix1 = min(ix0 + 1u, NX - 1u);
    uint iy0 = uint(floor(y)), iy1 = min(iy0 + 1u, NY - 1u);
    float v00 = src_at(ix0 + iy0 * NX, is_u), v10 = src_at(ix1 + iy0 * NX, is_u);
    float v01 = src_at(ix0 + iy1 * NX, is_u), v11 = src_at(ix1 + iy1 * NX, is_u);
    float tx = x - float(ix0), ty = y - float(iy0);
    return mix(mix(v00, v10, tx), mix(v01, v11, tx), ty);
}

// ---------- 主函数 ----------
void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= NX * NY) return;

    float dx = 1.0f / float(NX);
    uint i = idx % NX;
    uint j = idx / NX;
    float u = uSrc.data[idx];
    float v = vSrc.data[idx];

    // 反向追踪
    float bx = float(i) + 0.5f - u * DT / dx;
    float by = float(j) + 0.5f - v * DT / dx;
    float sx = bx - 0.5f, sy = by - 0.5f;

    uDst.data[idx] = sampleBilinear(sx, sy, true);
    vDst.data[idx] = sampleBilinear(sx, sy, false);
}