#version 450

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(constant_id = 0) const uint NX = 128u;
layout(constant_id = 1) const uint NY = 128u;

layout(std430, binding = 0) buffer USrc { float data[]; } uSrc;
layout(std430, binding = 1) buffer VSrc { float data[]; } vSrc;
layout(std430, binding = 2) buffer UDst { float data[]; } uDst;
layout(std430, binding = 3) buffer VDst { float data[]; } vDst;

layout(std430, binding = 5) buffer LeftB   { uint data[]; } left;
layout(std430, binding = 6) buffer RightB  { uint data[]; } right;
layout(std430, binding = 7) buffer BottomB { uint data[]; } bottom;
layout(std430, binding = 8) buffer TopB    { uint data[]; } top;

layout(push_constant) uniform Params { float alpha; float beta; } pc;

// ---------- 边界值（速度 BC，与 advection.comp 一致） ----------
float border_velocity(float vi, bool is_u, int edge, uint local) {
    uint bi = local * 3u;
    uint type;
    float bc_u, bc_v;

    if (edge == 0) {
        type = left.data[bi];
        bc_u = uintBitsToFloat(left.data[bi+1u]);
        bc_v = uintBitsToFloat(left.data[bi+2u]);
    } else if (edge == 1) {
        type = right.data[bi];
        bc_u = uintBitsToFloat(right.data[bi+1u]);
        bc_v = uintBitsToFloat(right.data[bi+2u]);
    } else if (edge == 2) {
        type = bottom.data[bi];
        bc_u = uintBitsToFloat(bottom.data[bi+1u]);
        bc_v = uintBitsToFloat(bottom.data[bi+2u]);
    } else {
        type = top.data[bi];
        bc_u = uintBitsToFloat(top.data[bi+1u]);
        bc_v = uintBitsToFloat(top.data[bi+2u]);
    }
    switch (type) {
        case 0: // NoSlipWall: 反射
            return -vi;
        case 1: // SlipWall: 法向反射, 切向保持
            return ((edge <= 1) == is_u) ? -vi : vi;
        case 2: // Velocity
            return is_u ? (2.0 * bc_u - vi) : (2.0 * bc_v - vi);
        case 3: // Pressure
            return vi;
    }
    return 0.0f;
}

// ---------- 边界感知的邻居查询 ----------
float getNeighborU(int i, int j) {
    if (i >= 0 && i < int(NX) && j >= 0 && j < int(NY)) {
        return uSrc.data[uint(i) + uint(j) * NX];
    }
    int ci = clamp(i, 0, int(NX) - 1);
    int cj = clamp(j, 0, int(NY) - 1);
    float vi = uSrc.data[uint(ci) + uint(cj) * NX];
    int edge; uint local;
    if (i < 0) {
        edge = 0; local = uint(cj);
    } else if (i >= int(NX)) {
        edge = 1; local = uint(cj);
    } else if (j < 0) {
        edge = 2; local = uint(ci);
    } else {
        edge = 3; local = uint(ci);
    }
    return border_velocity(vi, true, edge, local);
}

float getNeighborV(int i, int j) {
    if (i >= 0 && i < int(NX) && j >= 0 && j < int(NY)) {
        return vSrc.data[uint(i) + uint(j) * NX];
    }
    int ci = clamp(i, 0, int(NX) - 1);
    int cj = clamp(j, 0, int(NY) - 1);
    float vi = vSrc.data[uint(ci) + uint(cj) * NX];
    int edge; uint local;
    if (i < 0) {
        edge = 0; local = uint(cj);
    } else if (i >= int(NX)) {
        edge = 1; local = uint(cj);
    } else if (j < 0) {
        edge = 2; local = uint(ci);
    } else {
        edge = 3; local = uint(ci);
    }
    return border_velocity(vi, false, edge, local);
}

// ---------- 主函数 ----------
void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= NX * NY) return;

    uint i = idx % NX;
    uint j = idx / NX;

    // u 分量
    float u_left   = getNeighborU(int(i)-1, int(j));
    float u_right  = getNeighborU(int(i)+1, int(j));
    float u_bottom = getNeighborU(int(i), int(j)-1);
    float u_top    = getNeighborU(int(i), int(j)+1);
    float u_b = uSrc.data[idx];
    uDst.data[idx] = (u_left + u_right + u_bottom + u_top + pc.alpha * u_b) / pc.beta;

    // v 分量
    float v_left   = getNeighborV(int(i)-1, int(j));
    float v_right  = getNeighborV(int(i)+1, int(j));
    float v_bottom = getNeighborV(int(i), int(j)-1);
    float v_top    = getNeighborV(int(i), int(j)+1);
    float v_b = vSrc.data[idx];
    vDst.data[idx] = (v_left + v_right + v_bottom + v_top + pc.alpha * v_b) / pc.beta;
}