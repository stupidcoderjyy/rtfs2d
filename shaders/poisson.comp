#version 450

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(constant_id = 0) const uint NX = 128u;
layout(constant_id = 1) const uint NY = 128u;

const float DT = 0.016f;

layout(std430, binding = 0) buffer USrc { float data[]; } uSrc;
layout(std430, binding = 1) buffer VSrc { float data[]; } vSrc;
layout(std430, binding = 2) buffer DivSrc { float data[]; } divSrc;
layout(std430, binding = 3) buffer PSrc { float data[]; } pSrc;
layout(std430, binding = 4) buffer PDst { float data[]; } pDst;

layout(std430, binding = 5) buffer LeftB   { uint data[]; } left;
layout(std430, binding = 6) buffer RightB  { uint data[]; } right;
layout(std430, binding = 7) buffer BottomB { uint data[]; } bottom;
layout(std430, binding = 8) buffer TopB    { uint data[]; } top;

layout(push_constant) uniform Params { float alpha; float beta; } pc;

// ---------- 边界值（压力 BC） ----------
float border_pressure(float pi, int edge, int ci, int cj) {
    uint local = uint((edge <= 1) ? cj : ci);
    uint bi = local * 3u;
    uint type;
    float bc_u, bc_v;

    if (edge == 0) {
        type = left.data[bi];
        bc_u = uintBitsToFloat(left.data[bi+1u]);
        bc_v = uintBitsToFloat(left.data[bi+2u]);
    } else if (edge == 1) {
        type = right.data[bi];
        bc_u = uintBitsToFloat(right.data[bi+1u]);
        bc_v = uintBitsToFloat(right.data[bi+2u]);
    } else if (edge == 2) {
        type = bottom.data[bi];
        bc_u = uintBitsToFloat(bottom.data[bi+1u]);
        bc_v = uintBitsToFloat(bottom.data[bi+2u]);
    } else {
        type = top.data[bi];
        bc_u = uintBitsToFloat(top.data[bi+1u]);
        bc_v = uintBitsToFloat(top.data[bi+2u]);
    }
    switch (type) {
        case 0: // NoSlipWall: Neumann dp/dn=0
            return pi;
        case 1: // SlipWall: Neumann dp/dn=0
            return pi;
        case 2: { // Velocity: p_b = p_i + (u_face - ubc_n) * dx / dt
            uint i_idx = uint(ci) + uint(cj) * NX;
            float un_i = (edge <= 1) ? uSrc.data[i_idx] : vSrc.data[i_idx];
            float ubc_n = (edge <= 1) ? bc_u : bc_v;
            float u_face = 0.5 * ((2.0 * ubc_n - un_i) + un_i);
            float dx = 1.0f / float(NX);
            return pi + (u_face - ubc_n) * (dx / DT);
        }
        case 3: // Pressure: Dirichlet p=0 -> ghost = -pi
            return -pi;
    }
    return 0.0f;
}

// ---------- 边界感知的邻居查询 ----------
float getNeighborP(int i, int j) {
    if (i >= 0 && i < int(NX) && j >= 0 && j < int(NY)) {
        return pSrc.data[uint(i) + uint(j) * NX];
    }
    int ci = clamp(i, 0, int(NX) - 1);
    int cj = clamp(j, 0, int(NY) - 1);
    float vi = pSrc.data[uint(ci) + uint(cj) * NX];
    int edge;
    if (i < 0) {
        edge = 0;
    } else if (i >= int(NX)) {
        edge = 1;
    } else if (j < 0) {
        edge = 2;
    } else {
        edge = 3;
    }
    return border_pressure(vi, edge, ci, cj);
}

// ---------- 主函数 ----------
void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= NX * NY) return;

    uint i = idx % NX;
    uint j = idx / NX;

    float left   = getNeighborP(int(i)-1, int(j));
    float right  = getNeighborP(int(i)+1, int(j));
    float bottom = getNeighborP(int(i), int(j)-1);
    float top    = getNeighborP(int(i), int(j)+1);

    float b = divSrc.data[idx];
    pDst.data[idx] = (left + right + bottom + top + pc.alpha * b) / pc.beta;
}