#version 450

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(constant_id = 0) const uint NX = 128u;
layout(constant_id = 1) const uint NY = 128u;
layout(constant_id = 2) const float DX = 1.0f / 128.0f;
layout(constant_id = 3) const float DY = 1.0f / 128.0f;

struct PolyObstacle {
    uint vert_count;
    uint _pad;
    vec2 aabb_min;
    vec2 aabb_max;
    vec2 verts[64];
};

layout(std430, binding = 9) buffer PolySSBO {
    uint obstacle_count;
    PolyObstacle obstacles[16];
} poly;

layout(std430, binding = 12) buffer MaskBuf { float data[]; } mask;

// ---------- 射线投射 ----------
bool pointInPolygon(vec2 p, int obs_idx) {
    uint vc = poly.obstacles[obs_idx].vert_count;
    if (vc < 3) return false;
    bool inside = false;
    for (uint i = 0u, j = vc - 1u; i < vc; j = i++) {
        vec2 vi = poly.obstacles[obs_idx].verts[i];
        vec2 vj = poly.obstacles[obs_idx].verts[j];
        if (((vi.y > p.y) != (vj.y > p.y)) &&
            (p.x < (vj.x - vi.x) * (p.y - vi.y) / (vj.y - vi.y) + vi.x)) {
            inside = !inside;
        }
    }
    return inside;
}

// ---------- 点到线段距离 ----------
float distToSegment(vec2 p, vec2 a, vec2 b) {
    vec2 ab = b - a;
    vec2 ap = p - a;
    float t = clamp(dot(ap, ab) / dot(ab, ab), 0.0, 1.0);
    return length(ap - ab * t);
}

// ---------- 到所有障碍边的最小距离 ----------
float minEdgeDist(vec2 p, float margin) {
    float d = 1.0;
    for (uint oi = 0u; oi < poly.obstacle_count; ++oi) {
        vec2 amin = poly.obstacles[oi].aabb_min;
        vec2 amax = poly.obstacles[oi].aabb_max;
        if (p.x < amin.x - margin || p.x > amax.x + margin ||
            p.y < amin.y - margin || p.y > amax.y + margin) continue;

        uint vc = poly.obstacles[oi].vert_count;
        if (vc < 2) continue;
        for (uint i = 0u; i + 1u < vc; ++i) {
            d = min(d, distToSegment(
                p,
                poly.obstacles[oi].verts[i],
                poly.obstacles[oi].verts[i + 1u]));
        }
    }
    return d;
}

// ---------- 主函数 ----------
void main() {
    uint gidx = gl_GlobalInvocationID.x;
    if (gidx >= NX * NY) return;

    uint i = gidx % NX;
    uint j = gidx / NX;

    const float IDX_2_PHY_X = DX;
    const float IDX_2_PHY_Y = DY;
    float cx = (float(i) + 0.5) * IDX_2_PHY_X;
    float cy = (float(j) + 0.5) * IDX_2_PHY_Y;

    vec2 pos = vec2(cx, cy);

    float inside = 0.0;
    for (uint oi = 0u; oi < poly.obstacle_count; ++oi) {
        vec2 amin = poly.obstacles[oi].aabb_min;
        vec2 amax = poly.obstacles[oi].aabb_max;
        if (cx < amin.x || cx > amax.x || cy < amin.y || cy > amax.y) continue;

        if (pointInPolygon(pos, int(oi))) {
            inside = 1.0;
            break;
        }
    }

    float margin = 2.0 * max(DX, DY);
    float edge = minEdgeDist(pos, margin);

    mask.data[gidx * 2u]     = inside;
    mask.data[gidx * 2u + 1u] = edge;
}