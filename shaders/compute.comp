#version 450

// 工作组大小：128 个线程沿 X 方向
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

// 存储缓冲区：绑定到 set = 0, binding = 0，用于存储场数据
layout(set = 0, binding = 0, std430) buffer FieldBuffer {
    float values[];
};

void main() {
    // 全局调用索引（假设总线程数 = nx * ny）
    uint idx = gl_GlobalInvocationID.x;

    // 网格分辨率（必须与 CPU 端的 grid_params_ 一致）
    uint nx = 128u;
    uint ny = 128u;

    if (idx < nx * ny) {
        // 计算二维索引
        uint i = idx % nx;   // 列索引 (x)
        uint j = idx / nx;   // 行索引 (y)

        // 归一化坐标 [0, 1]
        float fx = float(i) / float(nx);
        float fy = float(j) / float(ny);

        // 距中心 (0.5, 0.5) 的径向距离，并映射到 [0, 1] 范围
        vec2 p = vec2(fx - 0.5, fy - 0.5) * 2.0;  // 范围 [-1, 1]
        float r = length(p);                      // 半径范围 [0, sqrt(2)]

        // 正弦波纹，值域 [0, 1]
        float val = sin(r * 20.0) * 0.5 + 0.5;

        // 写入缓冲区
        values[idx] = val;
    }
}