#version 450

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

const uint NX = 128u;
const uint NY = 128u;
const float DX = 1.0f / float(NX);
const float INV_2DX = 0.5f / DX;

const uint TOP_START    = 0u;
const uint BOTTOM_START = NX;
const uint LEFT_START   = 2u * NX;
const uint RIGHT_START  = 2u * NX + NY;

layout(std430, binding = 2) buffer UBuffer { float data[]; } u;
layout(std430, binding = 3) buffer VBuffer { float data[]; } v;
layout(std430, binding = 5) buffer BCType  { int data[]; } bc_type;
layout(std430, binding = 6) buffer BCVelU  { float data[]; } bc_vel_u;
layout(std430, binding = 7) buffer BCVelV  { float data[]; } bc_vel_v;

layout(push_constant) uniform Params { float epsilon; } pc;

float getU(int i, int j, uint self_idx) {
    if (i >= 0 && i < int(NX) && j >= 0 && j < int(NY)) {
        uint idx = uint(i) + uint(j) * NX;
        return u.data[idx];
    }
    int dir = -1; uint local = 0;
    if (i < 0) { dir = 0; local = uint(j); }
    else if (i >= int(NX)) { dir = 2; local = uint(j); }
    else if (j < 0) { dir = 3; local = uint(i); }
    else { dir = 1; local = uint(i); }
    uint offset = (dir == 0) ? LEFT_START : (dir == 2) ? RIGHT_START : (dir == 1) ? TOP_START : BOTTOM_START;
    int t = bc_type.data[offset + local];
    if (t == 1) return 0.0f;
    else if (t == 2) return bc_vel_u.data[offset + local];
    else if (t == 3) {
        int ci = (i < 0) ? 0 : (i >= int(NX)) ? int(NX)-1 : i;
        int cj = (j < 0) ? 0 : (j >= int(NY)) ? int(NY)-1 : j;
        return u.data[uint(ci) + uint(cj) * NX];
    }
    return 0.0f;
}

float getV(int i, int j, uint self_idx) {
    if (i >= 0 && i < int(NX) && j >= 0 && j < int(NY)) {
        uint idx = uint(i) + uint(j) * NX;
        return v.data[idx];
    }
    int dir = -1; uint local = 0;
    if (i < 0) { dir = 0; local = uint(j); }
    else if (i >= int(NX)) { dir = 2; local = uint(j); }
    else if (j < 0) { dir = 3; local = uint(i); }
    else { dir = 1; local = uint(i); }
    uint offset = (dir == 0) ? LEFT_START : (dir == 2) ? RIGHT_START : (dir == 1) ? TOP_START : BOTTOM_START;
    int t = bc_type.data[offset + local];
    if (t == 1) return 0.0f;
    else if (t == 2) return bc_vel_v.data[offset + local];
    else if (t == 3) {
        int ci = (i < 0) ? 0 : (i >= int(NX)) ? int(NX)-1 : i;
        int cj = (j < 0) ? 0 : (j >= int(NY)) ? int(NY)-1 : j;
        return v.data[uint(ci) + uint(cj) * NX];
    }
    return 0.0f;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= NX * NY) return;

    uint i = idx % NX;
    uint j = idx / NX;

    // 1) ω = ∂v/∂x - ∂u/∂y
    float v_left  = getV(int(i)-1, int(j), idx);
    float v_right = getV(int(i)+1, int(j), idx);
    float u_down  = getU(int(i), int(j)-1, idx);
    float u_up    = getU(int(i), int(j)+1, idx);
    float omega = (v_right - v_left - u_up + u_down) * INV_2DX;

    // 2) ∇|ω|
    float wr = abs((getV(int(i) + 2, int(j), idx) - getV(int(i), int(j), idx)) * INV_2DX
                 - (getU(int(i) + 1, int(j) + 1, idx) - getU(int(i) + 1, int(j) - 1, idx)) * INV_2DX);
    float wl = abs((getV(int(i), int(j), idx) - getV(int(i) - 2, int(j), idx)) * INV_2DX
                 - (getU(int(i) - 1, int(j) + 1, idx) - getU(int(i) - 1, int(j) - 1, idx)) * INV_2DX);
    float wu = abs((getV(int(i) + 1, int(j) + 1, idx) - getV(int(i) - 1, int(j) + 1, idx)) * INV_2DX
                 - (getU(int(i), int(j) + 2, idx) - getU(int(i), int(j), idx)) * INV_2DX);
    float wd = abs((getV(int(i) + 1, int(j) - 1, idx) - getV(int(i) - 1, int(j) - 1, idx)) * INV_2DX
                 - (getU(int(i), int(j), idx) - getU(int(i), int(j) - 2, idx)) * INV_2DX);

    float grad_x = (wr - wl) * INV_2DX;
    float grad_y = (wu - wd) * INV_2DX;

    // 3) F = ε * DX * (N × ω)
    float len = length(vec2(grad_x, grad_y));
    float nx = 0.0, ny = 0.0;
    if (len > 1e-6) { nx = grad_x / len; ny = grad_y / len; }

    float fx = pc.epsilon * DX * ny * omega;
    float fy = -pc.epsilon * DX * nx * omega;

    // 壁面衰减：距边界 3 格内抑制力
    float dist = float(min(min(i, j), min(NX - 1u - i, NY - 1u - j)));
    float damp = min(1.0, dist / 3.0);
    fx *= damp; fy *= damp;

    // 力幅值上限：每帧速度变化不超过 2 个网格单元
    float f_max = 2.0 / DX;
    float fmag = length(vec2(fx, fy));
    if (fmag > f_max) { fx *= f_max / fmag; fy *= f_max / fmag; }

    u.data[idx] += fx;
    v.data[idx] += fy;
}