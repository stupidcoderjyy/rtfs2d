#version 450

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(constant_id = 0) const uint NX = 128u;
layout(constant_id = 1) const uint NY = 128u;
layout(constant_id = 2) const float INV_DX = 128.0;
layout(constant_id = 3) const float INV_DY = 128.0;

layout(std430, binding = 0) buffer UBuffer { float data[]; } u;
layout(std430, binding = 1) buffer VBuffer { float data[]; } v;
layout(std430, binding = 2) buffer ScalarBuffer { float data[]; } scalar;
layout(std430, binding = 3) buffer PressureBuffer { float data[]; } p;
layout(std430, binding = 12) buffer MaskBuf { float data[]; } mask;

layout(push_constant) uniform Params { uint mode; float coeff; } pc;

bool isObstacle(uint ci, uint cj) {
    if (ci >= NX || cj >= NY) return false;
    return mask.data[(ci + cj * NX) * 2u] > 0.5;
}

float sampleSmooth(int ci, int cj, bool isU) {
    if (ci < 0 || ci >= int(NX) || cj < 0 || cj >= int(NY)) return 0.0;
    if (isObstacle(uint(ci), uint(cj))) return 0.0;

    float sum = 0.0;
    uint count = 0u;
    const int w = 1;
    for (int dj = -w; dj <= w; ++dj) {
        for (int di = -w; di <= w; ++di) {
            int ni = ci + di;
            int nj = cj + dj;
            if (ni < 0 || ni >= int(NX) || nj < 0 || nj >= int(NY)) continue;
            if (isObstacle(uint(ni), uint(nj))) continue;
            uint nidx = uint(ni) + uint(nj) * NX;
            sum +=isU ? u.data[nidx] : v.data[nidx];
            count++;
        }
    }
    return sum / float(count);
}

float dvdxSmooth(int ci, int cj, float dx_inv) {
    float vl = sampleSmooth(ci - 1, cj, false);
    float vr = sampleSmooth(ci + 1, cj, false);
    return (vr - vl) * 0.5 * dx_inv;
}

float dudySmooth(int ci, int cj, float dx_inv) {
    float ub = sampleSmooth(ci, cj - 1, true);
    float ut = sampleSmooth(ci, cj + 1, true);
    return (ut - ub) * 0.5 * dx_inv;
}

float computeVorticity(uint idx, uint i, uint j) {
    if (isObstacle(i, j)) return 0.0;
    if (i < 1u || i >= NX - 1u || j < 1u || j >= NY - 1u) return 0.0;

    float dx_inv = INV_DX; float dy_inv = INV_DY;
    return dvdxSmooth(int(i), int(j), dx_inv) - dudySmooth(int(i), int(j), dy_inv);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= NX * NY) return;

    if (pc.mode == 0u) {
        float speed = sqrt(u.data[idx] * u.data[idx] + v.data[idx] * v.data[idx]);
        scalar.data[idx] = speed * pc.coeff;
    } else if (pc.mode == 1u) {
        scalar.data[idx] = p.data[idx] * pc.coeff;
    } else {
        uint i = idx % NX;
        uint j = idx / NX;
        scalar.data[idx] = abs(computeVorticity(idx, i, j)) * pc.coeff;
    }
}
