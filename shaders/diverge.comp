#version 450

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

const uint NX = 128u;
const uint NY = 128u;
const float DX = 1.0f / float(NX);
const float INV_2DX = 0.5f / DX;   // 预计算 1/(2*DX)

// 边界偏移常量
const uint TOP_START    = 0u;
const uint BOTTOM_START = NX;
const uint LEFT_START   = 2u * NX;
const uint RIGHT_START  = 2u * NX + NY;

layout(std430, binding = 1) buffer DivBuffer { float data[]; } div;
layout(std430, binding = 2) buffer UBuffer { float data[]; } u;
layout(std430, binding = 3) buffer VBuffer { float data[]; } v;
layout(std430, binding = 5) buffer BCType  { int data[]; } bc_type;
layout(std430, binding = 6) buffer BCVelU  { float data[]; } bc_vel_u;
layout(std430, binding = 7) buffer BCVelV  { float data[]; } bc_vel_v;

float getU(int i, int j, uint self_idx) {
    // 有效内部
    if (i >= 0 && i < int(NX) && j >= 0 && j < int(NY)) {
        uint idx = uint(i) + uint(j) * NX;
        return u.data[idx];
    }
    // 越界处理: 确定边界方向
    int dir = -1;
    uint local = 0;
    if (i < 0) { dir = 0; local = uint(j); }       // 左边界 (i=-1)
    else if (i >= int(NX)) { dir = 2; local = uint(j); } // 右边界 (i=NX)
    else if (j < 0) { dir = 3; local = uint(i); }   // 下边界 (j=-1)
    else { dir = 1; local = uint(i); }              // 上边界 (j=NY)

    uint offset = (dir == 0) ? LEFT_START : (dir == 2) ? RIGHT_START : (dir == 1) ? TOP_START : BOTTOM_START;
    int t = bc_type.data[offset + local];
    if (t == 1) { // NoSlipWall
        return 0.0f;
    } else if (t == 2) { // VelocityInlet
        return bc_vel_u.data[offset + local];
    } else if (t == 3) { // VelocityOutlet: 返回内部相邻速度
        int inside_i = (i < 0) ? 0 : (i >= int(NX)) ? int(NX)-1 : i;
        int inside_j = (j < 0) ? 0 : (j >= int(NY)) ? int(NY)-1 : j;
        uint inside_idx = uint(inside_i) + uint(inside_j) * NX;
        return u.data[inside_idx];
    } else {
        return 0.0f;
    }
}

float getV(int i, int j, uint self_idx) {
    if (i >= 0 && i < int(NX) && j >= 0 && j < int(NY)) {
        uint idx = uint(i) + uint(j) * NX;
        return v.data[idx];
    }
    int dir = -1;
    uint local = 0;
    if (i < 0) { dir = 0; local = uint(j); }
    else if (i >= int(NX)) { dir = 2; local = uint(j); }
    else if (j < 0) { dir = 3; local = uint(i); }
    else { dir = 1; local = uint(i); }

    uint offset = (dir == 0) ? LEFT_START : (dir == 2) ? RIGHT_START : (dir == 1) ? TOP_START : BOTTOM_START;
    int t = bc_type.data[offset + local];
    if (t == 1) {
        return 0.0f;
    } else if (t == 2) {
        return bc_vel_v.data[offset + local];
    } else if (t == 3) {
        int inside_i = (i < 0) ? 0 : (i >= int(NX)) ? int(NX)-1 : i;
        int inside_j = (j < 0) ? 0 : (j >= int(NY)) ? int(NY)-1 : j;
        uint inside_idx = uint(inside_i) + uint(inside_j) * NX;
        return v.data[inside_idx];
    } else {
        return 0.0f;
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= NX * NY) return;

    uint i = idx % NX;
    uint j = idx / NX;

    float u_left  = getU(int(i)-1, int(j), idx);
    float u_right = getU(int(i)+1, int(j), idx);
    float v_bottom = getV(int(i), int(j)-1, idx);
    float v_top    = getV(int(i), int(j)+1, idx);

    float div_val = (u_right - u_left + v_top - v_bottom) * INV_2DX;
    div.data[idx] = div_val;
}